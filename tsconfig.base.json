{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@nx-boilerplate/shared-contracts": ["./shared-contracts/src/index.ts"],
      "@nx-boilerplate/ui-charts": ["./libs/shared/ui-charts/src/index.ts"],
      "@nx-boilerplate/theme": ["./libs/shared/theme/src/index.ts"],
      "agendador-citas/Routes": [
        "./apps/agendador-citas/src/app/remote-entry/entry.routes.ts"
      ],
      "Login/Routes": ["./apps/login/src/app/remote-entry/entry.routes.ts"],
      "@nx-boilerplate/api-interfaces": [
        "./libs/shared/api-interfaces/src/index.ts"
      ],
      "@nx-boilerplate/layouts": [
        "./libs/shared/layouts/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
